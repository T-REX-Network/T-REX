ALCHEMY_KEY=your_alchemy_api_key_here

# scripts/deploy-and-record.sh and the seed*.sh scripts
DEPLOYER_PRIVATE_KEY=0xyour_deployer_private_key_here
BASESCAN_API_KEY=your_basescan_api_key_here

# Optional: uncomment to override the defaults
# ONCHAINID_IDENTITY_FACTORY=0x...        # default: read from $ONCHAINID_DEPLOYMENTS_DIR/<NETWORK_NAME>.json
# ONCHAINID_DEPLOYMENTS_DIR=../ONCHAINID/deployments
# FINAL_ADMIN_ADDRESS=0x...               # default: the deployer keeps the admin roles
# SEED_ACTOR_KEY_1=0x...                  # default: actor skipped
# SEED_ACTOR_KEY_2=0x...                  # default: actor skipped
