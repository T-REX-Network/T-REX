pragma solidity 0.8.30;

import { Token } from "contracts/token/Token.sol";
import { DeployConfig } from "scripts/deploy/lib/DeployConfig.sol";

import { ForkBase } from "./ForkBase.sol";

/// @notice After the handover, the protocol works end to end: the Operations Safe deploys a suite (the factory
///         mints its ONCHAINID), investors deploy their own identities, the issuer's agent registers them, mints
///         and the token moves; an unregistered receiver is refused.
contract ForkSmokeTest is ForkBase {

    function test_suiteIdentityMintAndTransfer() public {
        DeployConfig memory c = _config();
        _deployAndConfigure(c);
        _handOver(c);

        Token token = _suiteWithBalances(c, "smoke");
        assertTrue(token.onchainID() != address(0), "token identity minted by the factory");
        assertEq(token.balanceOf(alice), 100);

        vm.prank(alice);
        token.transfer(bob, 40);
        assertEq(token.balanceOf(alice), 60);
        assertEq(token.balanceOf(bob), 40);

        vm.prank(alice);
        vm.expectRevert();
        token.transfer(stranger, 1);
    }

}
