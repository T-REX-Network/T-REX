pragma solidity 0.8.30;

import { Test } from "@forge-std/Test.sol";

import { Probes, Step } from "scripts/deploy/lib/PlanTypes.sol";
import { Actor } from "scripts/deploy/lib/PlanTypes.sol";
import { TxBuilderJson } from "scripts/deploy/lib/TxBuilderJson.sol";

/// @notice Transaction Builder files parse back to the calls they were written from.
contract TxBuilderJsonTest is Test {

    function test_rendersParsableBatch() public view {
        Step[] memory steps = new Step[](2);
        steps[0] = Step("a", Actor.DeploymentSafe, address(0x1234), 0, hex"deadbeef", Probes.none());
        steps[1] = Step("b", Actor.DeploymentSafe, address(0x5678), 5, hex"", Probes.none());
        string memory json = TxBuilderJson.render(1, address(0x5afe), "T-REX test", "two calls", steps);

        assertEq(vm.parseJsonString(json, ".chainId"), "1");
        assertEq(vm.parseJsonAddress(json, ".meta.createdFromSafeAddress"), address(0x5afe));
        assertEq(vm.parseJsonAddress(json, ".transactions[0].to"), address(0x1234));
        assertEq(vm.parseJsonBytes(json, ".transactions[0].data"), hex"deadbeef");
        assertEq(vm.parseJsonString(json, ".transactions[1].value"), "5");
        assertEq(vm.parseJsonAddress(json, ".transactions[1].to"), address(0x5678));
    }

}
