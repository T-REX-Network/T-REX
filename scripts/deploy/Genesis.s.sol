pragma solidity 0.8.30;

import { DeployScriptBase } from "./DeployScriptBase.sol";
import { DeployConfig } from "./lib/DeployConfig.sol";

/// @title Genesis
/// @notice Genesis phase: checks the anchor, deploys the Genesis Deployer (a CreateX copy) through it, makes sure
///         the Safe v1.4.1 contracts are there (deploying them through the Safe Singleton Factory where they are
///         not), and creates the four Safes. Every step is permissionless; any funded key can send them.
/// @dev   forge script scripts/deploy/Genesis.s.sol --sig "status(string)" mainnet --rpc-url <rpc>
///        forge script scripts/deploy/Genesis.s.sol --sig "run(string)" mainnet --rpc-url <rpc> --broadcast
///      Re-running is safe: done steps are skipped, and anything at an expected address that is not the expected
///      code stops the run before the first transaction.
contract Genesis is DeployScriptBase {

    function run(string memory env) external {
        DeployConfig memory c = _loadPinned(env, true);
        _requireAnchor();
        _requireSafeFactoryIfNeeded();
        executorMode = Mode.SafeBatches;
        _run(c, _genesisSteps(c), "genesis");
        _chainReport();
        _summary();
    }

    function status(string memory env) external {
        DeployConfig memory c = _load(env);
        _chainReport();
        _printStatus(_genesisSteps(c));
    }

}
