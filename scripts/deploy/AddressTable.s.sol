pragma solidity 0.8.30;

import { console } from "@forge-std/Script.sol";

import { DeployScriptBase } from "./DeployScriptBase.sol";
import { DeployConfigLib } from "./lib/DeployConfig.sol";

/// @title AddressTable
/// @notice Writes and checks deploy/addresses/<env>.json: every contract of the deployment with how it is made
///         (CREATE2, CREATE3, nonce, Safe factory), its salt, init code hash and expected address, plus the commit
///         it was generated at. The table is the pin: the broadcasting scripts refuse to run when the build no
///         longer gives it.
/// @dev Needs no chain: the table is computed from deploy/config/<env>.json and the build (`forge build`, then the
///      `onchainid` profile build, see deploy/README.md).
///        forge script scripts/deploy/AddressTable.s.sol --sig "run(string,string)" mainnet $(git rev-parse HEAD)
///        forge script scripts/deploy/AddressTable.s.sol --sig "check(string)" mainnet
contract AddressTable is DeployScriptBase {

    function run(string memory env, string memory commit) external {
        string memory json = _addressTableJson(DeployConfigLib.load(env), commit);
        vm.createDir("deploy/addresses", true);
        vm.writeFile(_tablePath(env), json);
        console.log("Address table written to %s", _tablePath(env));
    }

    /// @notice Reverts, naming the differing rows, if the build no longer gives the committed table.
    function check(string memory env) external view {
        _compareTable(DeployConfigLib.load(env), true);
        console.log("%s matches the config and the build", _tablePath(env));
    }

}
