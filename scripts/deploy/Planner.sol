pragma solidity 0.8.30;

import { PlanBuilder } from "./PlanBuilder.sol";

/// @title Planner
/// @notice A deployable {PlanBuilder}: the executor creates one and runs every heavy builder in it, one call
///         frame per builder, so the memory spent reading and linking committed bytecode is released after each.
/// @dev Never deployed on chain; it exists only in the script or test that creates it.
contract Planner is PlanBuilder { }
