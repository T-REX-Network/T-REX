pragma solidity 0.8.30;

import { UtilityChecker } from "contracts/utils/UtilityChecker.sol";
import { UtilityCheckerProxy } from "contracts/utils/UtilityCheckerProxy.sol";

/// @title UtilityCheckerDeployer
/// @notice Deployment tooling, not protocol code: creates the UtilityChecker proxy, initialized with the
///         AccessManager that gates its upgrades.
/// @dev `UtilityChecker.initialize(accessManager)` names its authority, so the proxy no longer needs a caller that
///      hands ownership over. This contract stays for the address it gives the proxy: it is deployed through
///      CreateX CREATE3 (deterministic address) and creates the proxy with CREATE at its nonce 1, so the proxy
///      address is deterministic too and independent of the proxy's init code. It keeps no state and exposes no
///      function; its runtime is solc's empty-contract stub, kept only because CreateX refuses a creation without
///      code.
contract UtilityCheckerDeployer {

    constructor(address implementation, address accessManager) {
        new UtilityCheckerProxy(implementation, abi.encodeCall(UtilityChecker.initialize, (accessManager)));
    }

}
