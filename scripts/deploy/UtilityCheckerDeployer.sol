pragma solidity 0.8.30;

import { UtilityChecker } from "contracts/utils/UtilityChecker.sol";
import { UtilityCheckerProxy } from "contracts/utils/UtilityCheckerProxy.sol";

/// @title UtilityCheckerDeployer
/// @notice Deployment tooling, not protocol code: creates the UtilityChecker proxy and hands its ownership to
///         `owner` in the same constructor.
/// @dev `UtilityChecker.initialize()` makes `msg.sender` the owner. Deployed straight through CreateX CREATE3,
///      that sender would be CreateX's throwaway CREATE3 proxy and upgrades would be impossible forever. This
///      contract is deployed through CREATE3 instead (deterministic address), creates the proxy with CREATE at its
///      nonce 1 (so the proxy address is deterministic too), becomes the owner through `initialize`, and
///      transfers ownership to `owner` before the constructor returns. It keeps no state and exposes no function;
///      its runtime is solc's empty-contract stub, kept only because CreateX refuses a creation without code.
/// @dev The proper fix is a contract change letting `initialize` take the owner, as OpenZeppelin's review
///      recommends; until then this is the only way to get a deterministic, upgradeable UtilityChecker.
contract UtilityCheckerDeployer {

    constructor(address implementation, address owner) {
        UtilityCheckerProxy proxy =
            new UtilityCheckerProxy(implementation, abi.encodeCall(UtilityChecker.initialize, ()));
        UtilityChecker(address(proxy)).transferOwnership(owner);
    }

}
