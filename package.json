{
  "name": "@t-rex-network/t-rex",
  "version": "0.0.0-development",
  "description": "A fully compliant environment for the issuance and use of tokenized securities implementing the ERC-3643 standard.",
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "files": [
    "contracts",
    "out",
    "!out/build-info",
    "!out/**/*.t.sol",
    "!out/Test.sol",
    "!out/MockContract.sol",
    "!out/TREXSuiteTest.sol"
  ],
  "scripts": {
    "prepare": "husky || true && forge soldeer install",
    "build": "forge build",
    "format": "forge fmt --check",
    "format:fix": "forge fmt",
    "test": "forge test --gas-report",
    "test:core": "forge test --gas-report --no-match-path \"test/{fuzz,integration/mocks}/**/*.sol\"",
    "test:mutation": "bash mutation/run_mutation.sh",
    "coverage": "forge coverage --no-match-coverage \"(test|dependencies|scripts|vendor)\" --no-match-path \"test/{fuzz,integration/mocks}/**/*.sol\"",
    "coverage:report": "mkdir -p coverage && forge coverage --no-match-coverage \"(test|scripts|dependencies|vendor)\" --report lcov --report-file coverage/lcov.info && genhtml coverage/lcov.info -o coverage/report --branch-coverage && open coverage/report/index.html",
    "clean": "forge clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-REX-Network/T-REX.git"
  },
  "author": "ERC-3643 Association",
  "license": "SEE LICENSE IN LICENSE.md",
  "bugs": {
    "url": "https://github.com/T-REX-Network/T-REX/issues"
  },
  "homepage": "https://github.com/T-REX-Network/T-REX#README",
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6"
  }
}

