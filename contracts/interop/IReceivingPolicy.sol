pragma solidity 0.8.30;

/**
 * @title IReceivingPolicy
 * @dev The receiving policy a bridge answers for: which finality it admits for messages from one source.
 *
 * The one view is copied as it stands from CCIP 2.0 (`IAny2EVMMessageReceiverV2.getCCVsAndFinalityConfig`), so a
 * receipt bridge built on CCIP answers it with no adapter. On CCIP the sending bridge picks a message's finality
 * and only this policy, on the receiving side, checks it; the receiving contract never sees the finality a message
 * used. So the token reads the policy itself instead of trusting a label.
 */
interface IReceivingPolicy {

    /// @dev The verifiers and the finality the bridge admits for messages from `sourceChainSelector` sent by
    /// `sender`. An `allowedFinalityConfig` of zero admits fully finalized messages only.
    /// @param sourceChainSelector The CCIP selector of the source chain.
    /// @param sender The sending bridge on the source chain, as CCIP reports it (`abi.encode(address)` on EVM).
    /// @return requiredCCVs The verifiers that must all pass.
    /// @return optionalCCVs The verifiers of which `optionalThreshold` must pass.
    /// @return optionalThreshold How many optional verifiers must pass.
    /// @return allowedFinalityConfig The finality admitted, zero for full finality only.
    function getCCVsAndFinalityConfig(uint64 sourceChainSelector, bytes calldata sender)
        external
        view
        returns (
            address[] memory requiredCCVs,
            address[] memory optionalCCVs,
            uint8 optionalThreshold,
            bytes4 allowedFinalityConfig
        );

}
