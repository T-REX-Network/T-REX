pragma solidity 0.8.30;

/**
 * @title IRequestedFinality
 * @dev The finality a bridge requests for every message it sends, which it declares through a view.
 *
 * On CCIP the sending bridge picks a message's finality and its receiver only checks it on the other side. A token
 * that sends value through a bridge reads this view on every such send, so a bridge that would carry it before its
 * own chain's finality is refused at home instead of being trusted for a label.
 */
interface IRequestedFinality {

    /// @dev The finality the bridge requests for the messages it sends. Zero is CCIP's `WAIT_FOR_FINALITY_FLAG`:
    /// every message waits for full finality.
    /// @return The finality requested, zero for full finality.
    function requestedFinality() external view returns (bytes4);

}
